{
  "name": "zyro-electric-monorepo",
  "version": "1.0.44",
  "description": "ZYRO - Tech Accessories E-Commerce Platform (Monorepo: Frontend + Backend)",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "dotnet": ">=9.0.0"
  },
  "scripts": {
    "install:all": "npm install && cd frontend && npm install && cd ../backend && dotnet restore",
    "frontend:install": "cd frontend && npm install",
    "frontend:start": "cd frontend && npm start",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm test",
    "frontend:lint": "cd frontend && npm run lint",
    "backend:restore": "cd backend && dotnet restore",
    "backend:build": "cd backend && dotnet build",
    "backend:start": "cd backend && dotnet run",
    "backend:test": "cd backend && dotnet test",
    "backend:publish": "cd backend && dotnet publish -c Release",
    "backend:migrations": "cd backend && dotnet ef database update",
    "scripts:cache-report": "node scripts/generate-cache-report.js",
    "docs": "cd frontend && npx compodoc -p tsconfig.json -d ../docs",
    "prepare": "is-ci || husky || true"
  },
  "keywords": [
    "zyro",
    "tech-accessories",
    "e-commerce",
    "monorepo",
    "angular",
    "asp-net",
    "docker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/we3ds-solution/ZYRO-Electric.git"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0"
  },
  "dependencies": {
    "webpack": "^5.90.0"
  }
}
